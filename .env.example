# ============ 模型接入配置 ============
# 填好哪家就用哪家；三家都没 key 时整个系统走 mock 演示模式。
# 豆包必须同时填 API Key 和 DOUBAO_MODEL（方舟里的模型ID，如 doubao-seed-1-6-250615 或接入点 ep-xxx）。
# 以后加海外模型（OpenAI/Claude），照抄一段改名即可，代码零改动。

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=kimi-k3.1-pro
# kimi-k3 系列只接受 temperature=1
MOONSHOT_TEMPERATURE=1

DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=
